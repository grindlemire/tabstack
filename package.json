{
  "name": "tabstack",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.6",
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "bun scripts/build.ts --watch",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.3.6",
    "@types/chrome": "0.3.7",
    "typescript": "7.0.2"
  }
}
